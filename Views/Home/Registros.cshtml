@{
    ViewData["Title"] = "ÚLTIMAS ATIVIDADES RECENTES";
}

<style>
    .logo {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .logo span {
            color: var(--accent-orange);
        }

    .nav-item {
        padding: 10px 15px;
        margin-bottom: 5px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: 0.3s;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 15px;
    }

        .nav-item:hover, .nav-item.active {
            background-color: #334155;
            color: white;
        }

        .nav-item.active {
            border-left: 4px solid var(--accent-orange);
        }

    .main-content {
        flex-grow: 1;
        padding: 20px 40px;
        overflow-y: auto;
    }

    /* FILTROS RÁPIDOS */
    .filter-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
        background: #1e293b;
        padding: 15px;
        border-radius: 10px;
        border: 1px solid #334155;
        align-items: center;
    }

        .filter-bar input, .filter-bar select {
            background: #0f172a;
            border: 1px solid #475569;
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            outline: none;
        }

    /* TABELA ESTILIZADA */
    .table-container {
        background: #1e293b;
        border-radius: 12px;
        border: 1px solid #334155;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    th {
        background: #334155;
        padding: 15px;
        font-size: 12px;
        text-transform: uppercase;
        color: var(--accent-orange);
        letter-spacing: 1px;
    }

    td {
        padding: 15px;
        border-bottom: 1px solid #334155;
        font-size: 14px;
        color: var(--text-main);
    }

    tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    /* BADGES (ETIQUETAS) */
    .type-badge {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .in {
        background: rgba(34, 197, 94, 0.1);
        color: var(--accent-green);
    }

    .out {
        background: rgba(239, 68, 68, 0.1);
        color: var(--accent-red);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        font-size: 13px;
    }
</style>

<div class="main-content">
    <h2 style="margin-bottom: 5px;">HISTÓRICO DE MOVIMENTAÇÕES</h2>
    <p style="color: var(--text-muted); margin-bottom: 25px; font-size: 14px;">Registro completo de todas as entradas e saídas do estoque.</p>

    <div class="filter-bar">
        <span style="font-size: 13px; color: var(--text-muted);"><i class="fa-solid fa-filter"></i> Filtrar por:</span>
        <input type="date" value="2026-05-17">
        <select>
            <option>Todas as Operações</option>
            <option>Apenas Entradas</option>
            <option>Apenas Saídas</option>
        </select>
        <input type="text" placeholder="Buscar produto..." style="flex-grow: 1;">
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Data / Hora</th>
                    <th>Operação</th>
                    <th>Produto</th>
                    <th>Quantidade</th>
                    <th>Origem / Destino</th>
                    <th>Responsável</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>17/05 - 15:30</td>
                    <td><span class="type-badge in"><i class="fa-solid fa-arrow-down"></i> ENTRADA</span></td>
                    <td><strong>Farinha de Trigo Especial</strong></td>
                    <td style="color: var(--accent-green);">+ 50 Kg</td>
                    <td>Moinho de Trigo S.A.</td>
                    <td><div class="user-info"><i class="fa-solid fa-circle-user"></i> João Pedro</div></td>
                </tr>
                <tr>
                    <td>17/05 - 14:15</td>
                    <td><span class="type-badge out"><i class="fa-solid fa-arrow-up"></i> SAÍDA</span></td>
                    <td><strong>Açúcar Refinado</strong></td>
                    <td style="color: var(--accent-red);">- 10 Un</td>
                    <td>Cozinha / Confeitaria</td>
                    <td><div class="user-info"><i class="fa-solid fa-circle-user"></i> Ana Julia</div></td>
                </tr>
                <tr>
                    <td>17/05 - 11:05</td>
                    <td><span class="type-badge out"><i class="fa-solid fa-arrow-up"></i> SAÍDA</span></td>
                    <td><strong>Leite Condensado</strong></td>
                    <td style="color: var(--accent-red);">- 24 Un</td>
                    <td>Cozinha / Produção</td>
                    <td><div class="user-info"><i class="fa-solid fa-circle-user"></i> Letícia Ribeiro</div></td>
                </tr>
                <tr>
                    <td>17/05 - 09:20</td>
                    <td><span class="type-badge in"><i class="fa-solid fa-arrow-down"></i> ENTRADA</span></td>
                    <td><strong>Embalagem Kraft (G)</strong></td>
                    <td style="color: var(--accent-green);">+ 500 Un</td>
                    <td>Papelaria Central</td>
                    <td><div class="user-info"><i class="fa-solid fa-circle-user"></i> João Pedro</div></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
